{
  "name": "dsh-subagent-cost",
  "version": "0.1.4",
  "description": "DSH Web plugin: a dock pill and per-turn panel counting the subagent sessions a conversation spawned and what they cost, in CNY. · DSH 网页插件：在输入框工具条上统计本会话派出的子智能体数量与人民币花费，并按 turn 分组。",
  "type": "module",
  "license": "MIT",
  "author": "Synapse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Synapse-ACh/dsh-subagent-cost.git"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "token-usage",
    "cost",
    "子智能体",
    "费用统计",
    "token用量"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cost": "./lib/cost.js",
    "./aggregate": "./lib/aggregate.js"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "homepage": "https://github.com/Synapse-ACh/dsh-subagent-cost#readme",
  "bugs": {
    "url": "https://github.com/Synapse-ACh/dsh-subagent-cost/issues"
  }
}
